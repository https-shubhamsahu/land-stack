# Local frontend development only. This value belongs in .env.development,
# not in a production deployment.
VITE_API_BASE_URL=http://localhost:5000/api

# Required by the Vercel API function. Set these in Vercel Project Settings,
# not in a committed .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Required only when the frontend is hosted on a different origin.
FRONTEND_URL=https://your-production-domain.example
